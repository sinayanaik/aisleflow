__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
lda-pibt/
.pytest_cache/
.coverage
htmlcov/
results/
*.gif
*.mp4
*.png
!docs/*.png
# the comparison animations and generated figures are deliverables:
# they are committed so the documents render without running anything
!docs/gifs/*.gif
!docs/figures/*.png

# LaTeX build products. The distributable PDF is committed under docs/pdf/,
# built by tools/build_docs.py; everything latexmk leaves behind is not.
docs/latex/*.aux
docs/latex/*.bbl
docs/latex/*.blg
docs/latex/*.fdb_latexmk
docs/latex/*.fls
docs/latex/*.log
docs/latex/*.out
docs/latex/*.toc
docs/latex/aisleflow.pdf
docs/latex/*.fdb_latexmk
